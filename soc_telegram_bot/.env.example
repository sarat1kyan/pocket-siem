# ============================================================
# Pocket SIEM Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ── Telegram ─────────────────────────────────────────────────
# Create a bot via @BotFather → /newbot, then copy the token below.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Comma-separated list of Telegram user IDs allowed to use the bot.
# To find your ID: start the bot and send /whoami (no auth required).
# Example: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=

# Optional: push all proactive alerts to this specific chat or channel ID.
# If blank, alerts are sent to all users in ALLOWED_TELEGRAM_USER_IDS.
# TELEGRAM_CHAT_ID=

# ── Admin API ─────────────────────────────────────────────────
# API key required for FastAPI admin endpoints.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=generate-a-strong-random-key-here

# ── Trellix EDR ───────────────────────────────────────────────
ENABLE_TRELLIX=true

# Trellix API base URL (leave default for SaaS; override for on-prem ePO)
TRELLIX_BASE_URL=https://api.manage.trellix.com

# OAuth2 client credentials (preferred auth method for Trellix Cloud)
# Obtain from Trellix ePolicy Orchestrator → Client Management → Create Client
TRELLIX_CLIENT_ID=
TRELLIX_CLIENT_SECRET=

# Alternative: static API key (for ePO on-prem or tenant API key)
TRELLIX_API_KEY=

# Trellix tenant/account identifier (if required by your deployment)
TRELLIX_TENANT_ID=

# Set to false ONLY in a lab environment with a self-signed certificate.
# WARNING: disabling TLS verification exposes you to MITM attacks.
TRELLIX_VERIFY_SSL=true

# ── Palo Alto Networks ────────────────────────────────────────
ENABLE_PALOALTO=true

# Firewall hostname or IP address (without https://)
# Example: firewall.corp.example.com  or  192.168.1.1
PALOALTO_HOSTNAME=

# PAN-OS API key. Generate via:
#   curl -k "https://<firewall>/api/?type=keygen&user=<admin>&password=<pass>"
#   Then copy the <key> value from the XML response.
PALOALTO_API_KEY=

# Virtual system (default: vsys1). Change if you use multi-vsys.
PALOALTO_VSYS=vsys1

# Maximum number of log entries fetched per poll cycle (1–500)
PALOALTO_LOG_COUNT=50

# Set to false ONLY in a lab environment with a self-signed certificate.
PALOALTO_VERIFY_SSL=true

# ── Polling ───────────────────────────────────────────────────
# How often (seconds) to poll each data source. Minimum: 10.
POLL_INTERVAL_SECONDS=60

# ── Severity ─────────────────────────────────────────────────
# Minimum severity level to send as Telegram notifications.
# Options: low | medium | high | critical
# Default: high  (only high and critical events are notified)
MIN_SEVERITY=high

# ── Rate limiting ─────────────────────────────────────────────
# Maximum number of Telegram messages per minute (burst protection)
MAX_ALERTS_PER_MINUTE=20

# ── Database ─────────────────────────────────────────────────
# SQLite (default — data stored in ./data/soc_bot.db)
DATABASE_URL=sqlite+aiosqlite:///./data/soc_bot.db

# PostgreSQL example (uncomment and fill in to use Postgres instead):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/soc_bot

# ── FastAPI ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080

# ── Mock Mode ─────────────────────────────────────────────────
# Set to true to receive synthetic high-severity events without real APIs.
# Useful for testing Telegram notifications end-to-end.
MOCK_MODE=false

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Environment label (dev / staging / production) ───────────
# In production mode, /docs and /openapi.json are disabled.
ENVIRONMENT=production
